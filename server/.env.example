# ─────────────────────────────────────────────────────────────────
# AgriConnect Server Configuration & Real SMS OTP Gateways
# Copy this file to server/.env and fill in your preferred SMS provider.
# ─────────────────────────────────────────────────────────────────

PORT=5000
JWT_SECRET=agriconnect-secure-secret-key-2026

# OPTION 1: 2Factor.in (Recommended for India - Quickest setup without DLT)
# Sign up at https://2factor.in to get an instant API key with free test SMS
# TWOFACTOR_API_KEY=your_2factor_api_key_here

# OPTION 2: Fast2SMS (Popular India OTP gateway)
# Sign up at https://www.fast2sms.com and get your Authorization Key
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# OPTION 3: Twilio (Global & India)
# Sign up at https://www.twilio.com
# TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Optional: Twilio Verify Service SID
# TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OPTION 4: MSG91 (DLT Enterprise India)
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_dlt_template_id
